# Copy this file to .env and fill in your values

# Telegram bot token (required) — get it from @BotFather
TELEGRAM_TOKEN=

# Channel (optional) — /setchannel command se bhi set kar sakte ho
# Channel ID (-100...) ya @username
CHANNEL_ID=

# Admin Telegram user IDs, comma separated (invite links ke liye)
ADMIN_IDS=

# CoinGecko demo API key (optional — for higher rate limits, free at coingecko.com/en/api)
COINGECKO_KEY=

# Daily update time (24-hour format, IST) — default 9
DAILY_HOUR_IST=9

# Weekly report day (1=Mon, 2=Tue ... 7=Sun) and time — default Monday 9 AM
WEEKLY_DAY_ISO=1
WEEKLY_HOUR_IST=9
